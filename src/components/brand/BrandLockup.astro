---
interface Props {
  size?: "header" | "hero" | "footer";
  href?: string;
}

const { size = "header", href } = Astro.props;

type LockupGeometry = {
  height: number;
  width: number;
  src: string;
};

function lockupGeometry(value: "header" | "hero" | "footer"): LockupGeometry {
  // Horizontal lockup viewBox 900×190 → keep aspect 900/190 ≈ 4.737
  switch (value) {
    case "header":
      return {
        height: 28,
        width: 133,
        src: "/brand/blueskyz/r4d/lockup_horizontal_dark.svg",
      };
    case "hero":
      return {
        height: 44,
        width: 208,
        src: "/brand/blueskyz/r4d/lockup_horizontal_dark.svg",
      };
    case "footer":
      return {
        height: 28,
        width: 133,
        src: "/brand/blueskyz/r4d/lockup_horizontal_light.svg",
      };
    default: {
      const _exhaustive: never = value;
      return _exhaustive;
    }
  }
}

const geometry = lockupGeometry(size);
const Tag = href ? "a" : "p";
const className = [
  "brand-lockup inline-flex min-h-11 items-center no-underline",
  size === "header" && "brand-signal",
  size === "hero" && "brand-signal",
]
  .filter(Boolean)
  .join(" ");
---

<Tag href={href} class={className} aria-label="BlueSkyz Labs">
  <img
    src={geometry.src}
    alt="BlueSkyz Labs"
    width={geometry.width}
    height={geometry.height}
    class="block h-auto max-w-full"
    decoding="async"
  />
</Tag>
