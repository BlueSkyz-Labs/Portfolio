---
import type { CollectionEntry } from "astro:content";
import ProductStatus from "@/components/product/ProductStatus.astro";

interface Props {
  product: CollectionEntry<"products">;
  emphasis?: "default" | "hero";
}

const { product, emphasis = "default" } = Astro.props;
const { data } = product;
---

<article
  data-product-card
  class:list={[
    "rounded-[var(--radius-card)] border border-[var(--border-subtle)] bg-white p-6",
    emphasis === "hero" && "md:p-8",
  ]}
>
  <ProductStatus label={data.publicLabel} />
  <h3
    class:list={[
      "mt-3 font-semibold tracking-tight text-[var(--text-primary)]",
      emphasis === "hero" ? "text-2xl sm:text-3xl" : "text-xl",
    ]}
  >
    {data.name}
  </h3>
  <p class="mt-3 text-[var(--text-secondary)]">{data.shortDescription}</p>
  <p
    class="mt-4 text-xs font-medium uppercase tracking-wide text-[var(--text-muted)]"
  >
    {data.endorsement}
  </p>
  <a
    href={data.primaryAction.href}
    class="mt-5 inline-flex min-h-11 items-center text-sm font-semibold text-[var(--action-primary)] no-underline hover:underline"
  >
    {data.primaryAction.label}
  </a>
</article>
