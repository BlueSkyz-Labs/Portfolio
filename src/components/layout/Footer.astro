---
import Container from "@/components/layout/Container.astro";
import { FOOTER_LINKS, SITE } from "@/data/site";
---

<footer
  class="mt-auto border-t border-[var(--border-subtle)] bg-[var(--surface-subtle)]"
>
  <Container class="flex flex-col gap-6 py-10">
    <p class="font-semibold text-[var(--text-primary)]">{SITE.name}</p>
    <nav aria-label="Footer">
      <ul class="flex flex-wrap gap-x-5 gap-y-3">
        {
          FOOTER_LINKS.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-sm text-[var(--text-secondary)] no-underline hover:text-[var(--text-primary)]"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <p class="text-sm text-[var(--text-muted)]">
      {SITE.proposition}
    </p>
  </Container>
</footer>
