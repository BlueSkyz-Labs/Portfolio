---
import Container from "@/components/layout/Container.astro";
import { FOOTER_LINKS, SITE } from "@/data/site";
---

<footer
  class="mt-auto bg-[var(--surface-inverse)] text-[var(--brand-porcelain)]"
>
  <Container class="flex flex-col gap-6 py-12">
    <p class="font-semibold tracking-tight">{SITE.name}</p>
    <nav aria-label="Footer">
      <ul class="flex flex-wrap gap-x-5 gap-y-3">
        {
          FOOTER_LINKS.map((item) => (
            <li>
              <a
                href={item.href}
                class="inline-flex min-h-11 items-center text-sm text-[color-mix(in_srgb,var(--brand-porcelain)_82%,white)] no-underline hover:text-white"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <p
      class="max-w-2xl text-sm text-[color-mix(in_srgb,var(--brand-porcelain)_72%,white)]"
    >
      {SITE.proposition}
    </p>
  </Container>
</footer>
