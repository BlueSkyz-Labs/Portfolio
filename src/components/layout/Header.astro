---
import Container from "@/components/layout/Container.astro";
import ButtonLink from "@/components/ui/ButtonLink.astro";
import { NAV, SITE } from "@/data/site";
---

<header
  class="border-b border-[var(--border-subtle)] bg-[var(--surface-primary)]"
>
  <Container class="flex min-h-16 items-center justify-between gap-4 py-3">
    <a
      href="/"
      class="font-semibold tracking-tight text-[var(--text-primary)] no-underline"
      >{SITE.name}</a
    >

    <nav aria-label="Primary" class="hidden items-center gap-6 md:flex">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            class="text-sm font-medium text-[var(--text-secondary)] no-underline hover:text-[var(--text-primary)]"
          >
            {item.label}
          </a>
        ))
      }
      <ButtonLink href="/products/" variant="primary"
        >Explore products</ButtonLink
      >
    </nav>

    <details class="relative md:hidden">
      <summary
        class="inline-flex min-h-11 min-w-11 list-none items-center justify-center rounded-lg border border-[var(--border-subtle)] px-3 text-sm font-medium"
        >Menu</summary
      >
      <div
        class="absolute right-0 z-20 mt-2 w-56 rounded-lg border border-[var(--border-subtle)] bg-white p-3 shadow-sm"
      >
        <nav aria-label="Mobile" class="flex flex-col gap-2">
          {
            NAV.map((item) => (
              <a
                href={item.href}
                class="min-h-11 rounded-md px-3 py-2 text-sm font-medium text-[var(--text-primary)] no-underline hover:bg-[var(--surface-subtle)]"
              >
                {item.label}
              </a>
            ))
          }
          <ButtonLink href="/products/" class="w-full"
            >Explore products</ButtonLink
          >
        </nav>
      </div>
    </details>
  </Container>
</header>
