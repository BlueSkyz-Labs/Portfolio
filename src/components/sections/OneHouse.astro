---
const principles = [
  "Make complexity clearer.",
  "Use intelligence with purpose.",
  "Respect human agency.",
  "Build for real-world use.",
];
---

<section
  class="border-b border-[var(--border-subtle)] py-16"
  aria-labelledby="house-title"
>
  <h2 id="house-title" class="text-3xl font-semibold tracking-tight">
    One house
  </h2>
  <p class="mt-4 max-w-2xl text-lg text-[var(--text-secondary)]">
    We don’t build around one category. We build around a way of thinking.
  </p>
  <ul class="mt-8 grid gap-3 sm:grid-cols-2">
    {
      principles.map((item) => (
        <li class="rounded-[var(--radius-card)] border border-[var(--border-subtle)] bg-white px-5 py-4 text-[var(--text-primary)]">
          {item}
        </li>
      ))
    }
  </ul>
</section>
