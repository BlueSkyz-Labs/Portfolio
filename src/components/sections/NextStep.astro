---
import ButtonLink from "@/components/ui/ButtonLink.astro";
---

<section class="py-16" aria-labelledby="next-title">
  <h2 id="next-title" class="text-3xl font-semibold tracking-tight">
    Next step
  </h2>
  <p class="mt-4 max-w-2xl text-[var(--text-secondary)]">
    Explore products when they are ready to evaluate, or contact BlueSkyz when
    you have a concrete problem worth solving.
  </p>
  <div class="mt-8 flex flex-wrap gap-3">
    <ButtonLink href="/products/">Explore products</ButtonLink>
    <ButtonLink href="/contact/" variant="secondary">Contact</ButtonLink>
  </div>
</section>
