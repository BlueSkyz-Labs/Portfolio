---
type RevealTag = "div" | "section" | "article";

const Tag = (Astro.props.as ?? "div") as RevealTag;
const className = Astro.props.class ?? "";
const id = Astro.props.id as string | undefined;
const ariaLabelledby = Astro.props["aria-labelledby"] as string | undefined;
---

<Tag
  class:list={["reveal", className]}
  id={id}
  aria-labelledby={ariaLabelledby}
>
  <slot />
</Tag>
