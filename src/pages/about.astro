---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/layout/Container.astro";
---

<BaseLayout
  title="About"
  description="About BlueSkyz Labs — products that make complex things feel naturally clear."
>
  <section class="py-16">
    <Container>
      <h1 class="text-3xl font-semibold tracking-tight">About BlueSkyz</h1>
      <p class="mt-4 max-w-2xl text-[var(--text-secondary)]">
        BlueSkyz Labs builds digital products that make complex things feel
        naturally clear.
      </p>
      <p class="mt-4 text-sm font-medium text-[var(--text-muted)]">
        Tony Nguyen — Founder &amp; CEO
      </p>
      <p class="mt-8 max-w-2xl text-sm text-[var(--text-muted)]">
        Extended founder or company biography publishes only after approved
        public truth is available. This page stays BlueSkyz-led, not a personal
        portfolio.
      </p>
    </Container>
  </section>
</BaseLayout>
