---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/layout/Container.astro";
---

<BaseLayout
  title="About"
  description="About BlueSkyz Labs — products that make complex things feel naturally clear."
>
  <section class="py-16">
    <Container>
      <h1 class="text-3xl font-semibold tracking-tight">About BlueSkyz</h1>
      <p class="mt-4 max-w-2xl text-[var(--text-secondary)]">
        BlueSkyz Labs builds digital products that make complex things feel
        naturally clear. Founder and company wording publish only after approved
        public truth is available.
      </p>
    </Container>
  </section>
</BaseLayout>
