---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/layout/Container.astro";
---

<BaseLayout
  title="Privacy"
  description="Privacy information for BlueSkyz Labs."
>
  <section class="py-16">
    <Container>
      <h1 class="text-3xl font-semibold tracking-tight">Privacy</h1>
      <p class="mt-4 max-w-2xl text-[var(--text-secondary)]">
        Privacy policy wording publishes after legal review. No tracking cookies
        are required for this static site foundation.
      </p>
    </Container>
  </section>
</BaseLayout>
