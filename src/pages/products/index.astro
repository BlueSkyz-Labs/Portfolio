---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/layout/Container.astro";
---

<BaseLayout title="Products" description="Explore BlueSkyz Labs products.">
  <section class="py-16">
    <Container>
      <h1 class="text-3xl font-semibold tracking-tight">Products</h1>
      <p class="mt-4 max-w-2xl text-[var(--text-secondary)]">
        Public product inventory will publish here once lifecycle, availability,
        and evidence gates are complete.
      </p>
    </Container>
  </section>
</BaseLayout>
