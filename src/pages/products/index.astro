---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/layout/Container.astro";
import ProductCard from "@/components/product/ProductCard.astro";
import { getPublicProducts } from "@/lib/products";

const products = await getPublicProducts();
---

<BaseLayout
  title="Products"
  description="Explore BlueSkyz Labs products with truthful status and evidence."
>
  <section class="py-16">
    <Container>
      <h1 class="text-3xl font-semibold tracking-tight">Products</h1>
      <p class="mt-4 max-w-2xl text-[var(--text-secondary)]">
        Listings appear only after public inclusion gates pass. Empty is
        preferred over invented maturity.
      </p>
      {
        products.length === 0 ? (
          <p class="mt-8 max-w-2xl border-y border-[var(--border-subtle)] py-6 text-[var(--text-secondary)]">
            No public products are published yet. Products appear here when
            identity, status, proof, and trust paths are verified.
          </p>
        ) : (
          <div class="mt-8 grid gap-4 md:grid-cols-2">
            {products.map((product) => (
              <ProductCard product={product} />
            ))}
          </div>
        )
      }
    </Container>
  </section>
</BaseLayout>
