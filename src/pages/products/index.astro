---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/layout/Container.astro";
import ProductCard from "@/components/product/ProductCard.astro";
import ButtonLink from "@/components/ui/ButtonLink.astro";
import { getPublicProducts } from "@/lib/products";

const products = await getPublicProducts();
---

<BaseLayout
  title="Products"
  description="Explore BlueSkyz Labs products with truthful status and evidence."
>
  <section class="py-16">
    <Container>
      <h1 class="text-3xl font-semibold tracking-tight">Products</h1>
      <p class="mt-4 max-w-2xl text-[var(--text-secondary)]">
        Products appear here when they are ready to evaluate. We publish only
        what you can verify.
      </p>
      {
        products.length === 0 ? (
          <div class="mt-8 max-w-2xl border-y border-[var(--border-subtle)] py-6">
            <p class="text-[var(--text-secondary)]">
              No public products are published yet. When a product is ready to
              evaluate, it will appear here with clear status and evidence.
            </p>
            <div class="mt-6 flex flex-wrap gap-3">
              <ButtonLink href="/contact/">Contact</ButtonLink>
              <ButtonLink href="/about/" variant="secondary">
                About BlueSkyz
              </ButtonLink>
            </div>
          </div>
        ) : (
          <div class="mt-8 grid gap-4 md:grid-cols-2">
            {products.map((product) => (
              <ProductCard product={product} />
            ))}
          </div>
        )
      }
    </Container>
  </section>
</BaseLayout>
