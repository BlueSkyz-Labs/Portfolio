---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/layout/Container.astro";
import { SITE } from "@/data/site";
---

<BaseLayout title="Contact" description="Contact BlueSkyz Labs.">
  <section class="py-16">
    <Container>
      <h1 class="text-3xl font-semibold tracking-tight">Contact</h1>
      <p class="mt-4 max-w-2xl text-[var(--text-secondary)]">
        {
          SITE.contactEmail ? (
            <>
              Email{" "}
              <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>
            </>
          ) : (
            "Contact routes publish when PUBLIC_CONTACT_EMAIL is configured for this environment."
          )
        }
      </p>
    </Container>
  </section>
</BaseLayout>
