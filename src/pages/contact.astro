---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/layout/Container.astro";
import { SITE } from "@/data/site";

const lanes = [
  {
    title: "Product support",
    body: "Product-specific support destinations publish on each product profile when verified.",
    href: "/support/",
    label: "Open support",
  },
  {
    title: "Business / general",
    body: SITE.contactEmail
      ? `Email ${SITE.contactEmail} for business inquiries.`
      : "Business contact publishes when PUBLIC_CONTACT_EMAIL is configured for this environment.",
    href: SITE.contactEmail ? `mailto:${SITE.contactEmail}` : null,
    label: SITE.contactEmail ? "Email BlueSkyz" : null,
  },
  {
    title: "Security",
    body: SITE.securityEmail
      ? `Report security issues to ${SITE.securityEmail}.`
      : "Use GitHub private vulnerability reporting (SECURITY.md). PUBLIC_SECURITY_EMAIL publishes when configured.",
    href: SITE.securityEmail ? `mailto:${SITE.securityEmail}` : "/security/",
    label: SITE.securityEmail ? "Email security" : "Security page",
  },
] as const;
---

<BaseLayout title="Contact" description="Contact BlueSkyz Labs.">
  <section class="py-16">
    <Container>
      <h1 class="text-3xl font-semibold tracking-tight">Contact</h1>
      <p class="mt-4 max-w-2xl text-[var(--text-secondary)]">
        Reach BlueSkyz through the lane that matches your need. Addresses appear
        only when configured for this environment.
      </p>
      <ul
        class="mt-10 divide-y divide-[var(--border-subtle)] border-y border-[var(--border-subtle)]"
      >
        {
          lanes.map((lane) => (
            <li class="py-6">
              <h2 class="text-lg font-semibold tracking-tight">{lane.title}</h2>
              <p class="mt-2 max-w-2xl text-[var(--text-secondary)]">
                {lane.body}
              </p>
              {lane.href && lane.label ? (
                <a
                  href={lane.href}
                  class="mt-4 inline-flex min-h-11 items-center text-sm font-semibold text-[var(--action-primary)] no-underline hover:underline"
                >
                  {lane.label}
                </a>
              ) : null}
            </li>
          ))
        }
      </ul>
    </Container>
  </section>
</BaseLayout>
