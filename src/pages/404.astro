---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/layout/Container.astro";
import ButtonLink from "@/components/ui/ButtonLink.astro";
import { SITE } from "@/data/site";
import { emptyRegistryPrimaryCta } from "@/lib/act";
import { getPublicProducts } from "@/lib/products";

const hasPublicProducts = (await getPublicProducts()).length > 0;
const emptyPrimary = emptyRegistryPrimaryCta(SITE.contactEmail);
---

<BaseLayout
  title="Page not found"
  description="The page you requested could not be found."
  noindex={true}
>
  <section class="py-20">
    <Container>
      <h1 class="text-3xl font-semibold tracking-tight">Page not found.</h1>
      <p class="mt-4 max-w-lg text-[var(--text-secondary)]">
        That address is not part of the BlueSkyz Labs site. You can return home
        {
          hasPublicProducts
            ? " or explore products."
            : SITE.contactEmail
              ? " or contact BlueSkyz."
              : " or learn who we are."
        }
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <ButtonLink href="/">Go home</ButtonLink>
        {
          hasPublicProducts ? (
            <ButtonLink href="/products/" variant="secondary">
              Explore products
            </ButtonLink>
          ) : (
            <ButtonLink href={emptyPrimary.href} variant="secondary">
              {emptyPrimary.label}
            </ButtonLink>
          )
        }
      </div>
    </Container>
  </section>
</BaseLayout>
