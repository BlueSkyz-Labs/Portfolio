---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/layout/Container.astro";
import { SITE } from "@/data/site";
---

<BaseLayout title="Support" description="Support for BlueSkyz Labs products.">
  <section class="py-16">
    <Container>
      <h1 class="text-3xl font-semibold tracking-tight">Support</h1>
      <p class="mt-4 max-w-2xl text-[var(--text-secondary)]">
        Product-specific support destinations publish on each product profile
        when verified. Until then, use the corporate contact lane or security
        reporting path below.
      </p>
      {
        SITE.contactEmail ? (
          <p class="mt-6 max-w-2xl text-[var(--text-secondary)]">
            Email{" "}
            <a
              href={`mailto:${SITE.contactEmail}`}
              class="inline-flex min-h-11 items-center font-semibold text-[var(--action-primary)] no-underline hover:underline"
            >
              {SITE.contactEmail}
            </a>{" "}
            for general product support until a product-specific path is
            published.
          </p>
        ) : (
          <p class="mt-6 max-w-2xl text-[var(--text-secondary)]">
            A corporate support email publishes when this environment is
            configured.
          </p>
        )
      }
      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href="/contact/"
          class="inline-flex min-h-11 items-center text-sm font-semibold text-[var(--action-primary)] no-underline hover:underline"
        >
          Contact BlueSkyz
        </a>
        <a
          href="/security/"
          class="inline-flex min-h-11 items-center text-sm font-semibold text-[var(--action-primary)] no-underline hover:underline"
        >
          Security reporting
        </a>
      </div>
    </Container>
  </section>
</BaseLayout>
