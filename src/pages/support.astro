---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/layout/Container.astro";
---

<BaseLayout title="Support" description="Support for BlueSkyz Labs products.">
  <section class="py-16">
    <Container>
      <h1 class="text-3xl font-semibold tracking-tight">Support</h1>
      <p class="mt-4 max-w-2xl text-[var(--text-secondary)]">
        Support destinations publish when product-specific recourse paths are
        approved.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href="/contact/"
          class="inline-flex min-h-11 items-center text-sm font-semibold text-[var(--action-primary)] no-underline hover:underline"
        >
          Contact BlueSkyz
        </a>
        <a
          href="/security/"
          class="inline-flex min-h-11 items-center text-sm font-semibold text-[var(--action-primary)] no-underline hover:underline"
        >
          Security reporting
        </a>
      </div>
    </Container>
  </section>
</BaseLayout>
