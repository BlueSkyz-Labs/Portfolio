---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/layout/Container.astro";
import ButtonLink from "@/components/ui/ButtonLink.astro";
import { SITE } from "@/data/site";
---

<BaseLayout
  title="Home"
  description="BlueSkyz Labs builds products that make complex things feel naturally clear."
>
  <section class="py-16 sm:py-24">
    <Container>
      <p class="text-sm font-medium text-[var(--text-muted)]">{SITE.name}</p>
      <h1
        class="mt-4 max-w-[18ch] text-4xl font-semibold tracking-tight text-[var(--text-primary)] sm:text-5xl"
      >
        {SITE.proposition}
      </h1>
      <p class="mt-5 max-w-xl text-lg text-[var(--text-secondary)]">
        Digital products with honest maturity, clear next steps, and evidence
        you can evaluate.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <ButtonLink href="/products/">Explore products</ButtonLink>
        <ButtonLink href="/about/" variant="secondary"
          >About BlueSkyz</ButtonLink
        >
      </div>
    </Container>
  </section>
</BaseLayout>
