# =============================================================================
# BlueSkyz Labs Portfolio — Environment Variables
# =============================================================================
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` to git. Only `.env.example` is tracked.
# =============================================================================

# ─── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://portfolio.tonydemo.com"
NEXT_PUBLIC_SITE_NAME="BlueSkyz Labs"

# ─── Analytics (Plausible — privacy-first, no cookies) ───────────────────────
NEXT_PUBLIC_PLAUSIBLE_DOMAIN="portfolio.tonydemo.com"
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL="https://plausible.io/js/script.js"

# ─── Contact (Form submission endpoint) ──────────────────────────────────────
# Replace with a Cloudflare Worker URL or Formspree endpoint.
NEXT_PUBLIC_CONTACT_ENDPOINT="https://api.tonydemo.com/contact"

# ─── Cloudflare Pages (set in dashboard, mirrored here for reference) ────────
# CF_PAGES_PROJECT_NAME="portfolio"
# CF_PAGES_BRANCH="main"
