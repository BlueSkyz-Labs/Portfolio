{
  "name": "blueskyz-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BlueSkyz Labs Web — C1.1 Porcelain-first, Trust-forward Hybrid Product House",
  "author": "BlueSkyz Labs <hello@blueskyz.io>",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.6.0+sha512.9a36518224080c6fe5165afdcfe79bfa118c29be703f3f462b1e32efe1e98e47e8750b148e08286250aad4113cc7993ca413c4e2cd447752708c2ee5751bc95f",
  "engines": {
    "node": ">=24.20.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && node scripts/verify-static-export.mjs",
    "start": "astro preview --host 127.0.0.1 --port 3000",
    "typecheck": "astro check",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier --write \"**/*.{astro,ts,tsx,js,mjs,json,md,css,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{astro,ts,tsx,js,mjs,json,md,css,yaml,yml}\"",
    "test:architecture": "node --test tests/architecture/*.test.mjs",
    "test:e2e": "playwright test --project=chromium --project=firefox --project=webkit --project=mobile-chromium",
    "check:client-budget": "node scripts/check-client-budget.mjs",
    "lighthouse": "lhci autorun",
    "prepare": "git config core.hooksPath .githooks || true",
    "validate:public-truth": "node scripts/validate-public-truth.mjs"
  },
  "dependencies": {
    "astro": "^7.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@axe-core/playwright": "4.13.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.9.0",
    "eslint": "^9.15.0",
    "eslint-plugin-astro": "^1.5.0",
    "postcss": "^8.4.49",
    "prettier": "^3.3.3",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  }
}
